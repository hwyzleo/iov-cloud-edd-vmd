<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>net.hwyz.iov.cloud.parent</groupId>
        <artifactId>service</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>net.hwyz.iov.cloud.edd</groupId>
    <artifactId>edd-vmd-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <properties>
        <!-- PAR-PROTO canonical wire（security.keyprov.v1） -->
        <protobuf.version>3.25.5</protobuf.version>
        <par-proto.version>0.0.1-SNAPSHOT</par-proto.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>net.hwyz.iov.cloud.edd</groupId>
            <artifactId>edd-vmd-api</artifactId>
        </dependency>
        <dependency>
            <groupId>net.hwyz.iov.cloud.edd</groupId>
            <artifactId>edd-mdm-api</artifactId>
        </dependency>
        <dependency>
            <groupId>net.hwyz.iov.cloud.iov</groupId>
            <artifactId>iov-tsp-api</artifactId>
        </dependency>
        <dependency>
            <groupId>net.hwyz.iov.cloud.iov</groupId>
            <artifactId>iov-idk-api</artifactId>
        </dependency>
        <dependency>
            <groupId>net.hwyz.iov.cloud.iov</groupId>
            <artifactId>iov-ota-api</artifactId>
        </dependency>

        <!-- 框架: MySQL -->
        <dependency>
            <groupId>net.hwyz.iov.cloud.framework</groupId>
            <artifactId>framework-mysql-starter</artifactId>
        </dependency>

        <!-- 框架: Redis -->
        <dependency>
            <groupId>net.hwyz.iov.cloud.framework</groupId>
            <artifactId>framework-redis-starter</artifactId>
        </dependency>

        <!-- 框架: Kafka -->
        <dependency>
            <groupId>net.hwyz.iov.cloud.framework</groupId>
            <artifactId>framework-kafka-starter</artifactId>
        </dependency>

        <!-- PAR-PROTO canonical wire：keyprov 上行/下行不复制 Proto、不手写 JSON codec（CR-058 Q3=B） -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf.version}</version>
        </dependency>
        <dependency>
            <groupId>net.hwyz.iov.cloud.proto</groupId>
            <artifactId>proto-vehicle-common</artifactId>
            <version>${par-proto.version}</version>
        </dependency>
        <dependency>
            <groupId>net.hwyz.iov.cloud.proto</groupId>
            <artifactId>proto-keyprov</artifactId>
            <version>${par-proto.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <!-- CR-073 G1：显式让 *IT 隔离测试被测试执行器发现（用户确认第 5 点：
                         *IT 必须被明确配置的测试执行器实际发现；脚本失败须返回非零） -->
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>